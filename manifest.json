{
  "manifest_version": 3,
  "name": "OTD Price",
  "version": "1.0.0",
  "description": "Overlays out-the-door car pricing on cars.com, Autotrader, and CarGurus: asking price + sales tax + dealer doc & title fees.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OTD Price Settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.cars.com/*",
        "https://*.autotrader.com/*",
        "https://*.cargurus.com/*"
      ],
      "js": [
        "data/tax-data.js",
        "content/calculator.js",
        "content/parsers/cars-parser.js",
        "content/parsers/autotrader-parser.js",
        "content/parsers/cargurus-parser.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/state-tax-rates.json"
      ],
      "matches": [
        "https://*.cars.com/*",
        "https://*.autotrader.com/*",
        "https://*.cargurus.com/*"
      ]
    }
  ]
}
